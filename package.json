{
  "name": "sms-otp-burner",
  "version": "1.0.0",
  "packageManager": "yarn@4.11.0",
  "description": "A simple website to lease a virtual number and display OTPs using React frontend",
  "license": "MIT",
  "scripts": {
    "start:backend": "export $(cat .env | xargs) && serverless offline start",
    "start:react": "vite",
    "build:react": "vite build",
    "preview:react": "vite preview",
    "test:frontend": "vitest run --project frontend",
    "test:backend": "vitest run --project backend",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:debug": "playwright test --debug",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --max-warnings 0",
    "start": "concurrently \"yarn start:backend\" \"yarn start:react\"",
    "deploy": "yarn build:react && serverless deploy",
    "clean": "rm -rf node_modules yarn.lock && yarn install"
  },
  "dependencies": {
    "mime-types": "^3.0.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "serverless": "^4.35.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-offline": "^14.4.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
